SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional From override (defaults to SMTP_USER)
SMTP_FROM=
# Destination inbox — never shown on public pages. Set in Railway Variables.
CONTACT_TO_EMAIL=
# Optional: HTTPS email (preferred on Railway — avoids SMTP port hangs)
# RESEND_API_KEY=
